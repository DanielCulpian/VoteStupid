# Exact frontend origin. Replace with the real HTTPS domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generate with: python scripts/configure_admin.py --write-env --local-http
# Never put a real password or production hash in this example.
ADMIN_PASSWORD_HASH=
# Keep true with HTTPS. Use false only in the private .env for local HTTP development.
ADMIN_COOKIE_SECURE=true

# Set a strong database password in your private .env before the first startup.
# An existing volume keeps its original password; changing this value does not rotate it.
POSTGRES_PASSWORD=
# Optional host development URL: configure privately with the same credentials.
# DATABASE_URL=postgresql+psycopg://votestupid:URL_ENCODED_PASSWORD@127.0.0.1:5432/votestupid

# Docker: reuse the existing volume. Verify where the data is stored before changing it.
POSTGRES_VOLUME_NAME=votestupid_postgres_data
# Set POSTGRES_PASSWORD only in your private .env, using the current database password.
HTTP_PORT=8080
DOCKER_PUBLIC_ORIGIN=http://localhost:8080
DOCKER_INTERNAL_SUBNET=172.30.78.0/24
NGINX_INTERNAL_IP=172.30.78.10

# Named tunnels only. Store the real token in .env, never here.
CLOUDFLARE_TUNNEL_TOKEN=
