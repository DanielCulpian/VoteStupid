# Origen exacto del frontend. En producción, sustituir por el dominio HTTPS real.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generar con: python scripts/configure_admin.py --write-env --local-http
# Nunca introducir aquí una contraseña real ni un hash de producción.
ADMIN_PASSWORD_HASH=
# Mantener true con HTTPS. false únicamente en el .env privado de desarrollo HTTP.
ADMIN_COOKIE_SECURE=true

# Mantener en el .env privado existente DATABASE_URL y POSTGRES_PASSWORD.
# No guardar credenciales reales en este ejemplo.

# Docker: reutiliza el volumen existente. No cambiar sin verificar dónde están los datos.
POSTGRES_VOLUME_NAME=votestupid_postgres_data
# Define POSTGRES_PASSWORD únicamente en tu .env privado, con la contraseña actual.
HTTP_PORT=8080
DOCKER_PUBLIC_ORIGIN=http://localhost:8080
DOCKER_INTERNAL_SUBNET=172.30.78.0/24
NGINX_INTERNAL_IP=172.30.78.10

# Solo para el túnel con nombre. Guardar el token real en .env, nunca aquí.
CLOUDFLARE_TUNNEL_TOKEN=
